        <script><![CDATA[(function executeRule(current, previous) {

    var item = current.getValue('item_used');
    var qtyUsed = parseInt(current.getValue('quantity_used'));

    if (!item || !qtyUsed) {
        return;
    }

    var inv = new GlideRecord('x_1896972_smart_0_inventory');

    if (inv.get(item)) {

        var available = parseInt(inv.getValue('quantity_available'));
        var remaining = available - qtyUsed;

        // Update quantity
        inv.setValue('quantity_available', remaining);

        // Update status
        if (remaining <= 0) {
            inv.setValue('status', 'out_of_stock');
        } 
        else if (remaining <= 10) {
            inv.setValue('status', 'low_stock');
        } 
        else {
            inv.setValue('status', 'available');
        }

        inv.update();
    }

})(current, previous);
]]></script>
