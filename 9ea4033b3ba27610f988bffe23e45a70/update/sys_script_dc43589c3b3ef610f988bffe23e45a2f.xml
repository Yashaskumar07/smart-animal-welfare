        <script><![CDATA[// Async Business Rule Script
(function executeRule(current, previous /*null when async*/) {

    // GlideRecord to find child incidents
    var childIncidents = new GlideRecord('incident');
    childIncidents.addQuery('parent', current.sys_id); // Find children of this parent
    childIncidents.query();

    while (childIncidents.next()) {
        // Close each child incident
        childIncidents.state = 7; // Closed
        childIncidents.update();
    }

})(current, previous);
]]></script>
